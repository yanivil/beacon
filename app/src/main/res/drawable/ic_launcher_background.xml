<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon, background layer: the design's yellow #FFD60A
     (BeaconColors.Accent), the colour of the widget's ON card, so the icon
     and the widget read as the same app on the home screen. A full 108 dp
     square: the launcher's mask cuts the shape (circle, squircle, ...).
     LauncherIconTest ties the colour to the token. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFD60A"
        android:pathData="M0,0h108v108h-108z" />
</vector>
