<?xml version="1.0" encoding="utf-8"?>
<!-- Beacon's launcher icon: an adaptive icon, so each launcher cuts it to
     its own shape. All layers are vectors, so one file covers every screen
     density; minSdk is 29, so no -v26 folder and no bitmap fallback are
     needed. The monochrome layer gives a themed icon on Android 13 and
     later. ic_launcher_round.xml is the same icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
