<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission on purpose: Beacon never talks to a network. -->

    <!-- Keeps the CPU awake while an alert blinks (always with a timeout), and
         lets the alert window open over other apps. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Glance updates the widget through WorkManager, whose own manifest adds
         these. Glance only uses it for short update sessions: never a
         foreground worker or a network constraint, and a session need not
         outlive a restart. So they are removed (ruling 2). Without
         RECEIVE_BOOT_COMPLETED the resume alarm isn't set again after a
         restart; alerts check the clock, so they resume on time anyway. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Package visibility (Android 11+): lets the app load the icons of the
         messaging apps it flashes for, and find the default SMS app. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:name=".BeaconApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beacon">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The real alert window: over other apps and the lock screen, own task,
             not in recents. No configChanges: rotation recreates it and it
             redraws from the controller's clock. -->
        <activity
            android:name=".alert.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Beacon"
            android:turnScreenOn="true" />
        <!-- Receives message notifications. Only the system can bind it. -->
        <service
            android:name=".alert.BeaconListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- The home-screen widget. Exported so the launcher can send it
             update requests; its label is the name in the widget picker. -->
        <receiver
            android:name=".widget.BeaconWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/beacon_widget_info" />
        </receiver>
        <!-- Receives Beacon's own resume alarm. Not exported: only the alarm's
             explicit pending intent reaches it. -->
        <receiver
            android:name=".widget.ResumeReceiver"
            android:exported="false" />
        <!-- Redraws the widget after a 12/24-hour, time-zone or language
             change (follow-up R1). All three actions are on Android's list
             of implicit broadcasts that a manifest receiver still gets on
             Android 8 and later. TIME_SET is also what Settings sends when
             the 12/24-hour switch changes. Not exported: a receiver that
             isn't exported still gets system broadcasts, and nothing else
             can reach it. None of the three needs a permission. -->
        <receiver
            android:name=".widget.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- WorkManager's foreground service; Beacon runs no foreground
             service (ruling 2). The class is declared only in WorkManager's
             own manifest, which this entry removes, so lint's MissingClass
             check can't find it here: ignored for this entry only. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
